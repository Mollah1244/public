{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/stablecoin-api/:path*",
      "destination": "https://api.circle.com/:path*"
    },
    {
      "source": "/circle-api/:path*",
      "destination": "https://api-sandbox.circle.com/:path*"
    },
    {
      "source": "/polymarket-api/:path*",
      "destination": "https://gamma-api.polymarket.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
